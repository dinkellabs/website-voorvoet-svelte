# ============================================================
# VoorVoet SvelteKit — Environment Variables
# Copy this file to .env and fill in the values.
# Variables prefixed PUBLIC_ are exposed to the client bundle.
# ============================================================

# ------------------------------------------------------------
# Cap (self-hosted, proof-of-work CAPTCHA)
# REQUIRED in production. Refuses to start otherwise.
# CAP_SECRET must be ≥16 bytes — generate with `openssl rand -hex 32`.
# PUBLIC_CAP_API_ENDPOINT is the path the widget POSTs to; the widget
# appends `challenge` and `redeem` (keep the trailing slash).
#
# PUBLIC_CAP_ENABLED gates whether the *client* renders the widget.
# Must be "true" on prod (matches CAP_ENABLED). Leave "false" on
# dev/staging so the form doesn't render a widget that can't solve
# against a server with CAP_ENABLED=false (would 404 /api/cap/challenge
# and leave the form stuck on "Verification required").
# ------------------------------------------------------------
CAP_ENABLED=false
CAP_SECRET=
PUBLIC_CAP_ENABLED=false
PUBLIC_CAP_API_ENDPOINT=/api/cap/

# ------------------------------------------------------------
# SMTP (ProtonMail)
# Required for contact/order forms to send emails.
# ------------------------------------------------------------
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=

# ------------------------------------------------------------
# Site
# ------------------------------------------------------------
SITE_URL=https://voorvoet.nl
PUBLIC_SITE_URL=https://voorvoet.nl

# ------------------------------------------------------------
# Appointment portal link
# Used by the "Maak een afspraak" CTA buttons. If empty, the CTAs
# fall back to the in-app contact page. Exposed to the client via
# the root +layout.server.ts load function.
# ------------------------------------------------------------
LINK_PLAN_PORTAL=

# ------------------------------------------------------------
# Reimbursement and pricing data files
# Names of the data files in src/lib/data/ that the reimbursements
# page should load. Leave empty to use the defaults baked into the
# code (reimbursements_2026.json / pricing_2026.csv). Add new files
# to src/lib/data/ to make them selectable here.
# ------------------------------------------------------------
REIMBURSEMENTS_DATA_FILE=
PRICING_DATA_FILE=

# ------------------------------------------------------------
# Blog display flags
# ------------------------------------------------------------
BLOG_SHOW_AUTHOR=false
BLOG_SHOW_PUBLICATION_DATE=false
PUBLIC_BLOG_SHOW_AUTHOR=false
PUBLIC_BLOG_SHOW_PUBLICATION_DATE=false

# ------------------------------------------------------------
# Umami analytics — set EITHER server-side OR client-side, not both.
# Setting both double-counts pageviews. The server-side path is
# automatically skipped when PUBLIC_UMAMI_SCRIPT_URL is set.
# ------------------------------------------------------------
# Server-side (works without JS, but doesn't capture SPA navigation):
# UMAMI_API_URL=https://umami.example.com/api/send
# UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# UMAMI_TIMEOUT_MS=1500

# Client-side (preferred — captures SPA navigation):
# PUBLIC_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------
# Proxy header trust
# Set automatically by docker-compose.yml. Adapter-node needs these to
# read X-Forwarded-For from your upstream reverse proxy; without them
# getClientAddress() returns the proxy IP and the rate limiter and Umami
# all collapse to one global bucket.
#
# XFF_DEPTH counts proxies in front of the app:
#   1 = one proxy (typical: host's Nginx/Caddy/Traefik)
#   2 = two proxies (e.g. Cloudflare → host proxy → app)
# ------------------------------------------------------------
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# BODY_SIZE_LIMIT=524288
